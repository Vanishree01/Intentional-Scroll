
{
  "manifest_version": 3,
  "name": "Intentional Scroll",
  "version": "1.0",
  "description": "A browser extension that encourages intentional social media use.",

  "permissions": [
    "storage",
    "tabs",
    "alarms"
  ],

  "host_permissions": [
    "https://www.instagram.com/*"
  ],

  "action": {
    "default_popup": "popup.html",
    "default_title": "Intentional Scroll"
  },

  "background": {
    "service_worker": "background.js"
  },

  "content_scripts": [
    {
      "matches": ["https://www.instagram.com/*"],
      "js": ["content.js"]
    }
  ]
}
